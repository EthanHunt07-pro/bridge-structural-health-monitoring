# Environment variables / secrets
# ==============================
.env
.env.*
!.env.example
data/raw/*.npy

# Ignore processed datasets by default
data/processed/*.npy

# Include only the small demo arrays required by Demo Mode
!data/processed/X_test.npy
!data/processed/y_test.npy


upload_samples/*.npy
